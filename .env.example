DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com,videos.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com,https://videos.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
JWT_SIGNING_KEY=replace-with-an-independent-jwt-signing-key
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

POSTGRES_DB=cabina360
POSTGRES_USER=cabina360
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/app/media
CADDY_ACCEL_REDIRECT_ENABLED=0
PUBLIC_BASE_URL=https://videos.example.com
EVENT_BASE_URL=https://videos.example.com/e
VIDEO_RETENTION_DEFAULT_DAYS=30
MAX_UPLOAD_SIZE_BYTES=536870912
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_SESSION_HOURS=48

CADDY_SITE_ADDRESS=:80
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
